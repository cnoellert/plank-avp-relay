[Unit]
Description=PLANK USB Ethernet appliance controller
After=local-fs.target systemd-networkd.service nftables.service
Before=plank-avp-relay.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/lib/plank-avp-relay/plank-avp-relay-usb
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=plank-avp-relay/usb
StateDirectoryMode=0700
RuntimeDirectory=plank-avp-relay/usb
RuntimeDirectoryMode=0700
UMask=0077
User=root
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target

#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop plank-tablet-relay-ble.service plank-tablet-relay-gadget.service >/dev/null 2>&1 || true
        deb-systemd-helper disable plank-tablet-relay-ble.service plank-tablet-relay-gadget.service >/dev/null 2>&1 || true
    fi
    /usr/lib/plank-avp-relay/plank-avp-relay-configure-host
    /usr/lib/plank-avp-relay/plank-avp-relay-hardware --firmware-only
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        # Apply the packaged battery-plugin policy before starting the relay.
        # Honor policy-rc.d and leave an inactive Bluetooth service inactive.
        deb-systemd-invoke try-restart bluetooth.service >/dev/null || true
    fi
fi
#DEBHELPER#

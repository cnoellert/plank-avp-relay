[Unit]
Description=PLANK Network and Bluetooth Tablet Relay
Wants=bluetooth.service avahi-daemon.service plank-tablet-relay-hardware.service
After=bluetooth.service avahi-daemon.service plank-tablet-relay-hardware.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/plank-tablet-relay-ble
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10
StateDirectory=plank-tablet-relay-ble
StateDirectoryMode=0700
UMask=0077
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_INET AF_INET6
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=char-input r

[Install]
WantedBy=multi-user.target

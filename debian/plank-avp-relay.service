[Unit]
Description=PLANK AVP Relay
Wants=bluetooth.service avahi-daemon.service plank-avp-relay-hardware.service plank-avp-relay-usb.service
After=bluetooth.service avahi-daemon.service plank-avp-relay-hardware.service plank-avp-relay-usb.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/plank-avp-relay
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10
StateDirectory=plank-avp-relay
StateDirectoryMode=0700
UMask=0077
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=-/var/lib/plank-avp-relay/usb
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH AF_INET AF_INET6
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=char-input r

[Install]
WantedBy=multi-user.target

#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export PKG_CONFIG_PATH = $(CURDIR)/debian/sodium-install/lib/pkgconfig

%:
	dh $@ --with python3 --buildsystem=cmake --builddirectory=debian/build

override_dh_python3:
	# The sibling .so is a ctypes library, not a CPython ABI extension.
	dh_python3 --no-shebang-rewrite /usr/lib/plank-tablet-relay-ble/ble_lab

override_dh_auto_configure:
	echo 'adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349  debian/vendor/libsodium-1.0.22.tar.gz' | sha256sum -c -
	mkdir -p debian/sodium-source debian/sodium-build
	tar -xzf debian/vendor/libsodium-1.0.22.tar.gz -C debian/sodium-source --strip-components=1
	cd debian/sodium-build && ../sodium-source/configure --prefix=$(CURDIR)/debian/sodium-install --disable-shared --enable-static --disable-asm --with-pic
	$(MAKE) -C debian/sodium-build
	$(MAKE) -C debian/sodium-build check
	$(MAKE) -C debian/sodium-build install
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Debug

override_dh_auto_test:
	ctest --test-dir debian/build --output-on-failure

override_dh_auto_install:
	install -D -m 0755 debian/build/libplank_ble_lab.so debian/plank-tablet-relay-ble/usr/lib/plank-tablet-relay-ble/libplank_ble_lab.so
	install -D -m 0755 packaging/ble/plank-tablet-relay-ble debian/plank-tablet-relay-ble/usr/bin/plank-tablet-relay-ble
	install -D -m 0755 packaging/ble/plank-tablet-relay-admin debian/plank-tablet-relay-ble/usr/sbin/plank-tablet-relay-admin
	install -d debian/plank-tablet-relay-ble/usr/lib/plank-tablet-relay-ble/ble_lab
	install -m 0644 tools/ble_lab/*.py debian/plank-tablet-relay-ble/usr/lib/plank-tablet-relay-ble/ble_lab/
	install -m 0755 packaging/ble/plank-tablet-relay-hardware debian/plank-tablet-relay-ble/usr/lib/plank-tablet-relay-ble/
	install -m 0755 packaging/ble/plank-tablet-relay-configure-host debian/plank-tablet-relay-ble/usr/lib/plank-tablet-relay-ble/
	install -D -m 0644 packaging/ble/plank-tablet-relay-hardware.service debian/plank-tablet-relay-ble/usr/lib/systemd/system/plank-tablet-relay-hardware.service
	install -d debian/plank-tablet-relay-ble/usr/share/plank-tablet-relay-ble/firmware
	install -m 0644 packaging/ble/firmware/* debian/plank-tablet-relay-ble/usr/share/plank-tablet-relay-ble/firmware/
	install -D -m 0644 packaging/ble/relay.conf debian/plank-tablet-relay-ble/etc/plank-tablet-relay-ble/relay.conf
	install -D -m 0644 debian/sodium-source/LICENSE debian/plank-tablet-relay-ble/usr/share/doc/plank-tablet-relay-ble/libsodium-LICENSE

override_dh_auto_clean:
	rm -rf debian/build debian/sodium-source debian/sodium-build debian/sodium-install

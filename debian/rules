#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export PKG_CONFIG_PATH = $(CURDIR)/debian/sodium-install/lib/pkgconfig

%:
	dh $@ --with python3 --buildsystem=cmake --builddirectory=debian/build

override_dh_python3:
	# The sibling .so is a ctypes library, not a CPython ABI extension.
	dh_python3 --no-shebang-rewrite /usr/lib/plank-avp-relay/avp_relay

override_dh_auto_configure:
	echo 'adbdd8f16149e81ac6078a03aca6fc03b592b89ef7b5ed83841c086191be3349  debian/vendor/libsodium-1.0.22.tar.gz' | sha256sum -c -
	mkdir -p debian/sodium-source debian/sodium-build
	tar -xzf debian/vendor/libsodium-1.0.22.tar.gz -C debian/sodium-source --strip-components=1
	cd debian/sodium-build && ../sodium-source/configure --prefix=$(CURDIR)/debian/sodium-install --disable-shared --enable-static --disable-asm --with-pic
	$(MAKE) -C debian/sodium-build
	$(MAKE) -C debian/sodium-build check
	$(MAKE) -C debian/sodium-build install
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Debug

override_dh_auto_test:
	ctest --test-dir debian/build --output-on-failure

override_dh_auto_install:
	install -D -m 0755 debian/build/libplank_avp_relay.so debian/plank-avp-relay/usr/lib/plank-avp-relay/libplank_avp_relay.so
	install -D -m 0755 packaging/ble/plank-avp-relay debian/plank-avp-relay/usr/bin/plank-avp-relay
	install -D -m 0755 packaging/ble/plank-avp-relay-admin debian/plank-avp-relay/usr/sbin/plank-avp-relay-admin
	install -d debian/plank-avp-relay/usr/lib/plank-avp-relay/avp_relay
	install -m 0644 tools/avp_relay/*.py debian/plank-avp-relay/usr/lib/plank-avp-relay/avp_relay/
	install -m 0755 packaging/ble/plank-avp-relay-hardware debian/plank-avp-relay/usr/lib/plank-avp-relay/
	install -m 0755 packaging/ble/plank-avp-relay-configure-host debian/plank-avp-relay/usr/lib/plank-avp-relay/
	install -m 0755 packaging/ble/plank-avp-relay-usb debian/plank-avp-relay/usr/lib/plank-avp-relay/
	install -m 0755 packaging/ble/plank-avp-relay-wifi debian/plank-avp-relay/usr/lib/plank-avp-relay/
	install -D -m 0644 packaging/ble/plank-avp-relay-wifi.service debian/plank-avp-relay/usr/lib/systemd/system/plank-avp-relay-wifi.service
	install -D -m 0644 packaging/ble/plank-avp-relay-hardware.service debian/plank-avp-relay/usr/lib/systemd/system/plank-avp-relay-hardware.service
	install -D -m 0644 packaging/ble/plank-avp-relay-usb.service debian/plank-avp-relay/usr/lib/systemd/system/plank-avp-relay-usb.service
	install -D -m 0644 packaging/ble/bluetooth-relay.conf debian/plank-avp-relay/usr/lib/systemd/system/bluetooth.service.d/10-plank-avp-relay.conf
	install -d debian/plank-avp-relay/usr/share/plank-avp-relay/firmware
	install -m 0644 packaging/ble/firmware/* debian/plank-avp-relay/usr/share/plank-avp-relay/firmware/
	install -m 0644 VERSION debian/plank-avp-relay/usr/share/plank-avp-relay/version
	install -D -m 0644 packaging/ble/relay.conf debian/plank-avp-relay/etc/plank-avp-relay/relay.conf
	install -D -m 0644 packaging/ble/usb-network.conf debian/plank-avp-relay/etc/plank-avp-relay/usb-network.conf
	install -D -m 0644 packaging/ble/wifi.conf debian/plank-avp-relay/etc/plank-avp-relay/wifi.conf
	install -d debian/plank-avp-relay/usr/share/plank-avp-relay/defaults
	install -m 0644 packaging/ble/relay.conf packaging/ble/usb-network.conf debian/plank-avp-relay/usr/share/plank-avp-relay/defaults/
	install -D -m 0644 debian/sodium-source/LICENSE debian/plank-avp-relay/usr/share/doc/plank-avp-relay/libsodium-LICENSE

override_dh_auto_clean:
	rm -rf debian/build debian/sodium-source debian/sodium-build debian/sodium-install

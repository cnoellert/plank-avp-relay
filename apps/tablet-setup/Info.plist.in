<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>la.instinctual.PLANK.TabletSetup</string>
    <key>CFBundleName</key><string>PLANK Tablet Setup</string>
    <key>CFBundleDisplayName</key><string>PLANK Tablet Setup</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>PLANKSetupVersion</key><string>${PLANK_SETUP_VERSION}</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Live setup connects to the tablet relay you select. Simulation does not use the network.</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
</dict></plist>

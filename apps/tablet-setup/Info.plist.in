<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>PLANKRegistrationAccessGroup</key>
    <string>$(AppIdentifierPrefix)la.instinctual.PLANK.DrawingRegistration</string>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>${PLANK_SETUP_BUNDLE_ID}</string>
    <key>CFBundleName</key><string>PLANK AVP Relay Setup</string>
    <key>CFBundleDisplayName</key><string>PLANK AVP Relay Setup</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>${PROJECT_VERSION}</string>
    <key>CFBundleVersion</key><string>${PLANK_SETUP_BUILD_NUMBER}</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>PLANKSetupVersion</key><string>${PLANK_SETUP_VERSION}</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Find your tablet relay, approve this headset, and display live tablet readings.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Find your tablet relay on the local network, set up your tablet, and receive encrypted pen readings.</string>
    <key>NSBonjourServices</key><array><string>_plank-avp-relay._tcp</string></array>
    <key>CFBundleURLTypes</key>
    <array><dict>
        <key>CFBundleURLName</key><string>${PLANK_SETUP_BUNDLE_ID}.launch</string>
        <key>CFBundleURLSchemes</key><array><string>plank-relay-setup</string></array>
    </dict></array>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
</dict></plist>
